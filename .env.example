# === CONFIGURAÇÃO DO SERVIDOR (Backend Java) ===
PORT=8080
# URL do frontend para liberar o CORS (ex: http://localhost:5500 em dev ou a URL da hospedagem em prod)
ALLOWED_ORIGIN=seu_endereco_frontend_aqui

# === SERVIÇO DE ENVIO DE E-MAIL (SMTP) ===
SMTP_HOST=seu_servidor_smtp_aqui
SMTP_PORT=587
SMTP_USER=seu_email_ou_usuario_smtp_aqui
SMTP_PASSWORD=sua_senha_de_app_ou_token_aqui

# === DESTINO DAS MENSAGENS DO FORMULÁRIO ===
# E-mail da conta do projeto (acesso da Bia) que receberá os dados da parceria
CONTACT_DESTINATION_EMAIL=email_destino_projeto@exemplo.com

# === SEGURANÇA (Rate Limit por IP) ===
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MINUTES=15